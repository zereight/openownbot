# The app of instance %i asks for an update with an empty file in update-requests.
# `openownbot-instance start` enables this unit for each instance.
[Unit]
Description=Update requests of OpenOwnBot instance %i

[Path]
PathExists=/srv/openownbot/%i/update-requests/update-stage
PathExists=/srv/openownbot/%i/update-requests/update-install

[Install]
WantedBy=paths.target
