# Downloads and unpacks a newer ROBot release next to the running one. openownbot-update.timer starts
# it; openownbot-update-apply.service moves the release into place at the next start of the server.
[Unit]
Description=Stage a ROBot update
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/ROBot/hosted/openownbot-hosted-update stage
Nice=19
IOSchedulingClass=idle
CPUWeight=idle
TimeoutStartSec=30min
