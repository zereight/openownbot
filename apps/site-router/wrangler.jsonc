{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openownbot-site-router",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "*.openbot.site/*",
      "zone_name": "openbot.site"
    }
  ],
  "vars": {
    // The account service origin. The report route `/_openownbot/report` and the links on error pages use it.
    "ACCOUNT_ORIGIN": "https://openbot.run"
  },
  "r2_buckets": [
    {
      "binding": "SITES",
      "bucket_name": "openownbot-sites",
      "preview_bucket_name": "openownbot-sites-test"
    }
  ]
}
