{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "paths": {
      "@robot/renderer-preview": ["./src/types/renderer-preview.d.ts"],
      "@robot/renderer-web": ["./src/types/renderer-web.d.ts"],
      "@robot/ui/features/conversation/MarkdownMessageText": ["./src/types/markdown-message-text.d.ts"]
    },
    "types": ["@cloudflare/workers-types", "vite/client", "@testing-library/jest-dom"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "scripts/**/*.ts",
    "vite.config.ts",
    "renderer-preview-alias.ts",
    "render-content-images.ts",
    "vitest.config.ts"
  ]
}
